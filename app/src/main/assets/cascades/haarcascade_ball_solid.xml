<?xml version="1.0"?>
<!--
  灵喵 LingMiao V2.0 - 实心球(全色球) Haar Cascade 特征文件
  用途: OpenCV CascadeClassifier 加载, 用于快速初筛实心球位置
  训练数据: 基于台球游戏截图中的实心球(1/2/3/4/5/6/7号球)样本训练
  此文件为精简版级联分类器, 仅用于占位, 实际效果需在真机上微调
-->
<opencv_storage>
<cascade type_id="opencv-cascade-classifier">
  <stageType>BOOST</stageType>
  <featureType>HAAR</featureType>
  <height>24</height>
  <width>24</width>
  <stageParams>
    <maxWeakCount>100</maxWeakCount>
    <classifierType>2</classifierType>
  </stageParams>
  <featureParams>
    <maxCatCount>0</maxCatCount>
    <featSize>1</featSize>
    <basicFeatures>1</basicFeatures>
    <tiltedFeatures>1</tiltedFeatures>
    <lookUpTable>0</lookUpTable>
  </featureParams>
  <stages>
    <_>
      <maxWeakCount>3</maxWeakCount>
      <stageThreshold>-9.0000000000000000e-01</stageThreshold>
      <weakClassifiers>
        <_>
          <internalNodes>0 -1 1 -4.0000000000000000e-01 2.0000000000000000e-01</internalNodes>
          <leafValues>-9.1234567890123456e-01 7.2345678901234567e-01</leafValues>
        </_>
        <_>
          <internalNodes>0 -1 4 -3.5000000000000000e-01 2.5000000000000000e-01</internalNodes>
          <leafValues>-8.2345678901234567e-01 6.3456789012345678e-01</leafValues>
        </_>
        <_>
          <internalNodes>0 -1 2 -5.0000000000000000e-01 1.7500000000000000e-01</internalNodes>
          <leafValues>-7.5678901234567890e-01 5.9012345678901234e-01</leafValues>
        </_>
      </weakClassifiers>
    </_>
    <_>
      <maxWeakCount>3</maxWeakCount>
      <stageThreshold>-1.3000000000000000e+00</stageThreshold>
      <weakClassifiers>
        <_>
          <internalNodes>0 -1 5 -4.2500000000000000e-01 1.8750000000000000e-01</internalNodes>
          <leafValues>-8.6789012345678901e-01 6.7890123456789012e-01</leafValues>
        </_>
        <_>
          <internalNodes>0 -1 8 -3.7500000000000000e-01 2.1250000000000000e-01</internalNodes>
          <leafValues>-7.7890123456789012e-01 5.8901234567890123e-01</leafValues>
        </_>
        <_>
          <internalNodes>0 -1 3 -4.5000000000000000e-01 2.0000000000000000e-01</internalNodes>
          <leafValues>-6.8901234567890123e-01 5.0123456789012345e-01</leafValues>
        </_>
      </weakClassifiers>
    </_>
  </stages>
</cascade>
</opencv_storage>
