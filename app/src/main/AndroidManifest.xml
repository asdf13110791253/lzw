<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Core permissions -->
    <!-- 悬浮窗权限（画辅助线必须） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 录屏权限 (Android 14+ 必须显式声明) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- 前台服务权限（防止被杀后台） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 通知权限（显示常驻通知） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 硬件特性声明 -->
    <uses-feature android:name="android.hardware.display" android:required="true" />
    <uses-feature android:name="android.hardware.screen" android:required="true" />

    <application
        android:name=".LingMiaoApp"
        android:allowBackup="true"
        android:label="灵喵 LingMiao"
        android:supportsRtl="false"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.LingMiao">

        <!-- 主界面：权限引导 + 设置入口 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 桌布校准 Activity -->
        <activity
            android:name=".ui.CalibrationActivity"
            android:exported="false" />

        <!-- 设置页 Activity -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <!-- 录屏授权中转 Activity（无 UI，自动回调） -->
        <activity
            android:name=".service.CapturePermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 核心录屏捕获服务（前台服务，独立进程） -->
        <service
            android:name=".service.CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:process=":capture" />

        <!-- 悬浮绘制服务（前台服务，独立进程） -->
        <service
            android:name=".service.OverlayService"
            android:exported="false"
            android:process=":overlay" />

    </application>
</manifest>
