<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lingmiao_config.xml" />
        <exclude domain="database" path="lingmiao.db" />
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="native/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="logs/" />
        <exclude domain="file" path="native/" />
    </device-transfer>
</data-extraction-rules>
